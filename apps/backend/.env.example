# Backend NestJS — variáveis de ambiente
#
# Copie para `.env` e preencha. O `.env` NÃO é versionado.

# ── Banco ────────────────────────────────────────────────────────────────────
# Este serviço é o dono do schema: as migrations vivem em apps/backend/prisma.
DATABASE_URL="postgresql://usuario:senha@localhost:5432/trainlab"
DIRECT_URL="postgresql://usuario:senha@localhost:5432/trainlab"

# ── Autenticação ─────────────────────────────────────────────────────────────
# O MESMO valor que o apps/web usa. O backend não emite sessão — ele só verifica
# o JWT que o BFF repassa, e a verificação falha em silêncio se os dois lados
# tiverem segredos diferentes.
#
# Gere com: openssl rand -base64 32
NEXTAUTH_SECRET=""

# ── Tempo real (Pusher) ──────────────────────────────────────────────────────
# Necessário desde a fatia 12: quem grava a mensagem dispara o evento da conversa.
#
# Ausente, o serviço NÃO quebra — as mensagens continuam sendo gravadas e a
# resposta é 200/201. O que se perde é a entrega instantânea: o outro lado só vê
# a mensagem no próximo fetch. O log avisa uma vez, no primeiro envio.
#
# São as MESMAS credenciais do apps/web — mesmo app do Pusher, senão os dois
# lados publicam em contas diferentes e o cliente nunca recebe o evento.
PUSHER_APP_ID=""
NEXT_PUBLIC_PUSHER_KEY=""
PUSHER_SECRET=""
NEXT_PUBLIC_PUSHER_CLUSTER=""

# ── Google Calendar / Meet ───────────────────────────────────────────────────
# Necessário desde a fatia 13: criar agendamento com `createMeet` gera o evento
# e o link do Meet.
#
# NÃO há fluxo OAuth próprio aqui. Os tokens do usuário vêm da tabela `Account`,
# gravada pelo PrismaAdapter do NextAuth no login social — por isso este serviço
# consegue usar o calendário sem sessão de navegador.
#
# Ausentes, nada quebra: a criação responde `meetNotAvailable: true` e o
# agendamento existe sem link. São as MESMAS credenciais do apps/web.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Usado só para montar o redirect URI do OAuth do Google, idêntico ao do NextAuth.
NEXTAUTH_URL="http://localhost:3000"

# Base dos links de confirmação enviados ao aluno (`/confirm/<token>`).
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# ── Stripe (fatia 15 — assinatura B2B) ───────────────────────────────────────
# Chave de teste da conta Stripe (`stripe config --list` mostra a sua, se já fez
# `stripe login` pela CLI). Sem ela, checkout/cancelamento/transferência lançam
# erro explícito na hora de usar — não falham em silêncio (ver stripe.service.ts).
STRIPE_SECRET_KEY=""

# Segredo de assinatura do endpoint B2B (`/stripe/webhook-b2b`). Em produção,
# vem do endpoint cadastrado no Dashboard. Em dev, a Dashboard não alcança
# localhost — use a Stripe CLI:
#
#   stripe listen --forward-to http://localhost:3001/stripe/webhook-b2b
#
# A CLI imprime "Your webhook signing secret is whsec_...": esse valor vai aqui.
# É o MESMO endpoint em todo `stripe listen` local (muda só se recriar o
# forwarding com --load-from-webhooks-api ou trocar de máquina).
STRIPE_WEBHOOK_SECRET_B2B=""

# Segredo de assinatura do endpoint de créditos (`/stripe/webhook-credits`).
# Mesma lógica do B2B acima, endpoint separado, segredo separado:
#
#   stripe listen --forward-to http://localhost:3001/stripe/webhook-credits
#
STRIPE_WEBHOOK_SECRET_CREDITS=""

# Segredo de assinatura do endpoint de Connect (`/stripe/webhook-connect`).
# Terceiro webhook dedicado (fatia 25): tier pago, sync de conta Connect
# (partner + affiliate) e reembolso. Endpoint separado, segredo separado.
# ATENÇÃO: este endpoint PRECISA ter "Listen to events on Connected accounts"
# ligado no Dashboard, senão `account.updated`/`account.application.deauthorized`
# nunca chegam (mesmo bug silencioso do legado).
#
#   stripe listen --forward-to http://localhost:3001/stripe/webhook-connect
#
STRIPE_WEBHOOK_SECRET_CONNECT=""

# ── Rede ─────────────────────────────────────────────────────────────────────
PORT=3001
