# Backend NestJS — variáveis de ambiente
#
# Copie para `.env` e preencha. O `.env` NÃO é versionado.

# ── Banco ────────────────────────────────────────────────────────────────────
# Este serviço é o dono do schema: as migrations vivem em apps/backend/prisma.
DATABASE_URL="postgresql://usuario:senha@localhost:5432/trainlab"
DIRECT_URL="postgresql://usuario:senha@localhost:5432/trainlab"

# ── Autenticação ─────────────────────────────────────────────────────────────
# O MESMO valor que o apps/web usa. O backend não emite sessão — ele só verifica
# o JWT que o BFF repassa, e a verificação falha em silêncio se os dois lados
# tiverem segredos diferentes.
#
# Gere com: openssl rand -base64 32
NEXTAUTH_SECRET=""

# ── Tempo real (Pusher) ──────────────────────────────────────────────────────
# Necessário desde a fatia 12: quem grava a mensagem dispara o evento da conversa.
#
# Ausente, o serviço NÃO quebra — as mensagens continuam sendo gravadas e a
# resposta é 200/201. O que se perde é a entrega instantânea: o outro lado só vê
# a mensagem no próximo fetch. O log avisa uma vez, no primeiro envio.
#
# São as MESMAS credenciais do apps/web — mesmo app do Pusher, senão os dois
# lados publicam em contas diferentes e o cliente nunca recebe o evento.
PUSHER_APP_ID=""
NEXT_PUBLIC_PUSHER_KEY=""
PUSHER_SECRET=""
NEXT_PUBLIC_PUSHER_CLUSTER=""

# ── Rede ─────────────────────────────────────────────────────────────────────
PORT=3001
