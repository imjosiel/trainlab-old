# TrainLab frontend (Next BFF) — variáveis de ambiente
#
# Copie para `.env.local` e preencha. Não é versionado.

# ── Sessão (NextAuth) ────────────────────────────────────────────────────────
# O MESMO valor que apps/backend usa. O frontend EMITE a sessão (Google OAuth +
# JWT/JWE); o backend só consome. Segredos divergentes = 401 em tudo
# (fail-closed dos dois lados).
#
# Gere com: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3002"

# ── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Banco (Prisma adapter + callbacks do NextAuth) ───────────────────────────
# MESMO banco que o backend.
DATABASE_URL="postgresql://usuario:senha@localhost:5432/trainlab"
DIRECT_URL="postgresql://usuario:senha@localhost:5432/trainlab"

# ── Backend Nest ─────────────────────────────────────────────────────────────
BACKEND_URL="http://localhost:3001"

# ── Tempo real (Pusher) ──────────────────────────────────────────────────────
# MESMAS credenciais do backend — mesmo app Pusher, senão os dois lados
# publicam em contas diferentes e o cliente nunca recebe o evento.
PUSHER_APP_ID=""
NEXT_PUBLIC_PUSHER_KEY=""
PUSHER_SECRET=""
NEXT_PUBLIC_PUSHER_CLUSTER=""

# ── Base pública (links de convite/confirm) ──────────────────────────────────
NEXT_PUBLIC_BASE_URL="http://localhost:3002"
