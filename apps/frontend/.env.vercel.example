# Frontend Next (BFF) na Vercel — variáveis de ambiente
#
# Project Settings → Environment Variables (Production + Preview).
# Root Directory: `apps/frontend`. Framework: Next.js.
#
# Regra de ouro: NEXTAUTH_SECRET IGUAL ao do Render. Segredos divergentes
# = 401 em tudo (fail-closed dos dois lados, sem log útil).

# ── Sessão (NextAuth — o frontend EMITE, o backend consome) ──
NEXTAUTH_SECRET=""            # MESMO valor do Render
NEXTAUTH_URL="https://<app>.vercel.app"

# ── Google OAuth ──
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Redirect URI no Google Cloud (adicionar o domínio de prod):
# https://<app>.vercel.app/api/auth/callback/google

# ── Banco (Prisma adapter + callbacks do NextAuth — MESMO banco do backend) ──
DATABASE_URL=""               # Neon (igual ao Render)
DIRECT_URL=""                 # Neon (igual ao Render)

# ── Backend Nest (Render) ──
BACKEND_URL="https://<backend>.onrender.com"

# ── Pusher (MESMO app do backend) ──
PUSHER_APP_ID=""
NEXT_PUBLIC_PUSHER_KEY=""
PUSHER_SECRET=""
NEXT_PUBLIC_PUSHER_CLUSTER=""

# ── Base pública (links /invite, /oferta, /confirm) ──
NEXT_PUBLIC_BASE_URL="https://<app>.vercel.app"
NEXT_PUBLIC_APP_URL="https://<app>.vercel.app"

# ── Stripe público ──
NEXT_PUBLIC_STRIPE_KEY="pk_live_..."

# ── Jitsi (CSP do next.config.js lê JITSI_DOMAIN no build) ──
JITSI_DOMAIN="meet.jit.si"
