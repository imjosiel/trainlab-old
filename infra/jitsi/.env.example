# Jitsi self-host (template — NÃO versionar preenchido)
# Copie para `.env` na mesma pasta e preencha. O `.env` NÃO é commitado.

# Domínio público do Jitsi (ex.: meet.meudominio.com.br)
XMPP_DOMAIN="meet.exemplo.com"

# Fuso horário dos containers
TZ="America/Sao_Paulo"

# Segredos internos (gerar com: openssl rand -hex 32)
JVB_AUTH_PASSWORD=""
JICOFO_AUTH_PASSWORD=""

# Secure domain (fatia 38) — DEVEM ser iguais ao backend:
# JITSI_APP_ID  <-> app_id do Prosody
# JITSI_JWT_SECRET <-> app_secret do Prosody
JITSI_APP_ID="trainlab"
JITSI_JWT_SECRET=""
